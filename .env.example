# Port exposed on your Synology NAS (http://<synology-ip>:3003)
HOST_PORT=3003

# Official API.Bible key (REST endpoint: https://rest.api.bible/v1) for licensed translations (NIV, NKJV, NLT, etc.)
API_BIBLE_KEY=
API_BIBLE_BASE_URL=https://rest.api.bible/v1

# Optional: Explicit comma-separated API.Bible IDs (when set, restricts API.Bible translations to this exact list)
# Example: NLT:d6e14a625393b4da-01,NIV:78a9f6124f344018-01,NKJV:63097d2a0a2f7db3-01
API_BIBLE_IDS=

# Optional: Official Tyndale NLT API key (https://api.nlt.to/)
NLT_API_KEY=

